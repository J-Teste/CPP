NAME := Aaaaaaaaaand...OPEN
CXX := c++
CXXFLAGS := -Wall -Wextra -Werror -std=c++98

SRCDIR := ./src
OBJDIR := tmp

SRC := \
	main.cpp \
	ClapTrap.cpp

SRCS := $(addprefix $(SRCDIR)/, $(SRC))

OBJ := $(addprefix $(OBJDIR)/, $(SRC:.cpp=.o))

all: $(NAME)

$(NAME): $(OBJ)
	@$(CXX) $(CXXFLAGS) -o $@ $^
	@echo "               =---:::::::::::----                       "
	@echo "              ---:::::::::::::::---                      "
	@echo "             =--::::::....::::::::-=                     "
	@echo "             --::::::.......::::::--                     "
	@echo "             -::::::.........:::::--                     "
