	@echo "        %%%%%@@=-------+#%@@@@%####%@@@@%#*-------       "
	@echo "        %%%#@@@+-------+#%@@%*#*+#%@@*@@##+------        "
	@echo "       %%%#@#@@*-------=##@%##*+=-==+#@@##=------        "
	@echo "      %%%#--*#@#:------=##@%%#*+===++*%###------*        "
	@echo "     @@%##=+@#@%:-------##@@@%**+++++*###*:::--=%#       "
	@echo "     %%#%%#@@@@@----:---##@@@@#*******+#*-:::--=@        "
	@echo "    @%%#%#%@@@@@=--:::::==-=%@@@%##+=:=-::::----         "
	@echo "     @  %#% @@@@*--:-:::::::---==-----+::::::::          "
	@echo "       @%#% @@@@@--::::::::----:::-+*=+.......-        <====== This is ClapTrap."
	@echo "       %##@  @@@@:.........#*########*=:......--         "
	@echo "       %#%@  @@@@=........:###+++++###:.::::::-=         "
